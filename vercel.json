{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{**/tests/**,**/__tests__/**,**/*.test.py,**/test_*.py,**/fixtures/**,**/__fixtures__/**,**/testdata/**,**/sample-data/**,**/static/**,**/assets/**,api/*.pkl}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
